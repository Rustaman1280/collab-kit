{
  "name": "@crustdev/collab-kit",
  "version": "1.0.0",
  "description": "Developer toolkit for distributed engineering collectives and pair-programming workflows",
  "type": "module",
  "author": "Rustaman Delvianova <rustaman@crusts.dev>",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "collab-kit": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "action.yml"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rustaman1280/collab-kit.git"
  },
  "bugs": {
    "url": "https://github.com/Rustaman1280/collab-kit/issues"
  },
  "homepage": "https://github.com/Rustaman1280/collab-kit#readme",
  "scripts": {
    "build": "tsc",
    "test": "node --test tests/*.test.js",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "co-author",
    "git-trailers",
    "collaboration",
    "developer-tools",
    "pair-programming",
    "crustdev"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
